{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Homebody",
  "version": "0.1.0",
  "identifier": "app.homebody.mac",
  "build": {
    "frontendDist": "../ui",
    "beforeBundleCommand": "cargo build --release -p homebody-cli && bash box/build.sh"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-",
      "files": {
        "MacOS/homebody": "../target/release/homebody",
        "MacOS/homebody-box": "../target/box/homebody-box",
        "Resources/box/image.sh": "../box/image.sh",
        "Resources/box/guest/forward.py": "../box/guest/forward.py",
        "Resources/box/guest/user-data": "../box/guest/user-data"
      }
    }
  }
}
